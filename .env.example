# Copy this file to ".env" and fill in real values. Never commit ".env".

# Which configuration to load: development | production | testing
FLASK_CONFIG=development

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: override the database (defaults to local SQLite app.db).
# Example Postgres URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/nebula

# Admin bootstrap credentials used by seed.py / create_admin.py.
# If ADMIN_PASSWORD is omitted, seed.py generates a random one and prints it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
